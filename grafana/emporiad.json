{
  "title": "Energy",
  "tags": [
    "emporiad",
    "power"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-1d/d+6h",
    "to": "now-1d/d+6h"
  },
  "description": "Emporia Vue: whole-house and per-circuit power from emporiad.",
  "panels": [
    {
      "type": "stat",
      "title": "Needs attention",
      "description": "emporiad down, no new minute pushed for 40 minutes (it polls every 15), the Vue offline in Emporia's cloud, repeated errors talking to Emporia or Prometheus, or the house drawing over 7 kW in any minute of the last 30.",
      "targets": [
        {
          "expr": "max by (issue) (label_replace(max(up{job=\"emporiad\"} == 0), \"issue\", \"emporiad down\", \"\", \"\")\nor label_replace(max(time() - emporia_newest_minute_timestamp_seconds > 2400), \"issue\", \"no new minutes for 40m+\", \"\", \"\")\nor label_replace(max(emporia_device_connected == 0), \"issue\", \"Vue offline in Emporia\", \"\", \"\")\nor label_replace(max(increase(emporia_poll_errors_total{stage!=\"weather\"}[1h]) > 2), \"issue\", \"Emporia or push errors\", \"\", \"\")\nor label_replace(max(max_over_time(emporia_power_watts{channel_num=\"1,2,3\"}[30m]) > 7000), \"issue\", \"drew over 7 kW in the last 30m\", \"\", \"\")\nor label_replace(max by (target) (time() - emporia_pushed_minute_timestamp_seconds > 2400), \"issue\", \"push to $1 behind 40m+\", \"target\", \"(.*)\"))",
          "legendFormat": "{{issue}}",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "absent(max by (issue) (label_replace(max(up{job=\"emporiad\"} == 0), \"issue\", \"emporiad down\", \"\", \"\")\nor label_replace(max(time() - emporia_newest_minute_timestamp_seconds > 2400), \"issue\", \"no new minutes for 40m+\", \"\", \"\")\nor label_replace(max(emporia_device_connected == 0), \"issue\", \"Vue offline in Emporia\", \"\", \"\")\nor label_replace(max(increase(emporia_poll_errors_total{stage!=\"weather\"}[1h]) > 2), \"issue\", \"Emporia or push errors\", \"\", \"\")\nor label_replace(max(max_over_time(emporia_power_watts{channel_num=\"1,2,3\"}[30m]) > 7000), \"issue\", \"drew over 7 kW in the last 30m\", \"\", \"\")\nor label_replace(max by (target) (time() - emporia_pushed_minute_timestamp_seconds > 2400), \"issue\", \"push to $1 behind 40m+\", \"target\", \"(.*)\")))",
          "legendFormat": "All clear",
          "instant": true,
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "All clear"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "name",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "transparent": true
    },
    {
      "type": "stat",
      "title": "Latest minute",
      "description": "Whole-house power in the newest minute pushed. emporiad fetches every 15 minutes, so it can be up to about 17 minutes old.",
      "targets": [
        {
          "expr": "sum(last_over_time(emporia_power_watts{channel_num=\"1,2,3\"}[30m]))",
          "instant": false,
          "range": true,
          "legendFormat": "Latest minute",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "transparent": true
    },
    {
      "type": "stat",
      "title": "Today",
      "description": "Energy since local midnight.",
      "targets": [
        {
          "expr": "sum(sum_over_time(emporia_power_watts{channel_num=\"1,2,3\"}[$__range])) / 60 / 1000",
          "instant": true,
          "range": false,
          "legendFormat": "Today",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 1
        }
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "timeFrom": "now/d",
      "hideTimeOverride": true,
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "transparent": true
    },
    {
      "type": "stat",
      "title": "Today's cost",
      "description": "Today's energy priced by Emporia with the rate plan selected in the app (no fixed charges), up to the last finished hour.",
      "targets": [
        {
          "expr": "sum(sum_over_time(emporia_hourly_cost{channel_num=\"1,2,3\"}[$__range]))",
          "instant": true,
          "range": false,
          "legendFormat": "Today's cost",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 2
        }
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "timeFrom": "now/d",
      "hideTimeOverride": true,
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "transparent": true
    },
    {
      "type": "stat",
      "title": "30-day cost",
      "description": "Last 30 days priced by Emporia's rate plan, by finished hour (only as far back as emporiad has pushed hourly cost; no fixed charges).",
      "targets": [
        {
          "expr": "sum(sum_over_time(emporia_hourly_cost{channel_num=\"1,2,3\"}[$__range]))",
          "instant": true,
          "range": false,
          "legendFormat": "30-day cost",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "timeFrom": "30d",
      "hideTimeOverride": true,
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "transparent": true
    },
    {
      "type": "stat",
      "title": "Baseload",
      "description": "What the house draws when nothing is running: the 5th percentile of the last 24 hours.",
      "targets": [
        {
          "expr": "quantile_over_time(0.05, sum(emporia_power_watts{channel_num=\"1,2,3\"})[24h:1m])",
          "instant": true,
          "range": false,
          "legendFormat": "Baseload",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 6,
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "transparent": true
    },
    {
      "type": "stat",
      "title": "Rate, last hour",
      "description": "What the last finished hour cost per kWh under the app's rate plan; it steps up once the billing cycle passes the tier-1 allowance.",
      "targets": [
        {
          "expr": "100 * sum(last_over_time(emporia_hourly_cost{channel_num=\"1,2,3\"}[2h])) / sum(last_over_time(emporia_hourly_energy_kwh{channel_num=\"1,2,3\"}[2h]))",
          "instant": true,
          "range": false,
          "legendFormat": "Rate",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:¢/kWh",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 1
        }
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 7,
      "gridPos": {
        "x": 20,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "transparent": true
    },
    {
      "type": "timeseries",
      "title": "HVAC",
      "description": "The circuits picked in HVAC, each drawn on its own (not stacked) as a 5-minute rolling average, with the outdoor temperature on the right axis: Open-Meteo's (from emporiad's --weather-lat and --weather-lon) and a weather station's (--ambient-mac), each empty without its flags.",
      "targets": [
        {
          "expr": "sum by (channel) (avg_over_time(emporia_power_watts{channel_num!~\"1,2,3|Balance\", channel=~\"${hvac}\"}[5m]))",
          "legendFormat": "{{channel}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "avg(last_over_time(weather_temperature_celsius{source=\"open-meteo\"}[1h]))",
          "legendFormat": "Outdoor temperature",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "avg(last_over_time(weather_temperature_celsius{source=\"ambient\"}[15m]))",
          "legendFormat": "Outdoor (station)",
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisWidth": 60
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Outdoor temperature"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "min"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "Outdoor"
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "light-blue",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineInterpolation",
                "value": "smooth"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Outdoor (station)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "min"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "Outdoor"
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dot",
                  "dash": [
                    0,
                    10
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineInterpolation",
                "value": "smooth"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "sortBy": "Mean",
          "sortDesc": true,
          "width": 400
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "transparent": true
    },
    {
      "type": "timeseries",
      "title": "High draw",
      "description": "The circuits picked in High draw (big appliances that are not HVAC), each drawn on its own (not stacked).",
      "targets": [
        {
          "expr": "sum by (channel) (emporia_power_watts{channel_num!~\"1,2,3|Balance\", channel=~\"${high_draw}\"})",
          "legendFormat": "{{channel}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisWidth": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "sortBy": "Mean",
          "sortDesc": true,
          "width": 400
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 18,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "transparent": true
    },
    {
      "type": "timeseries",
      "title": "Low draw",
      "description": "Every circuit not picked in HVAC or High draw, stacked, each a 15-minute rolling average; Unlabelled (Balance) is what no circuit sensor covers. Click a legend entry to isolate it.",
      "targets": [
        {
          "expr": "sum by (channel) (avg_over_time(emporia_power_watts{channel_num!~\"1,2,3|Balance\", channel!~\"${hvac}\", channel!~\"${high_draw}\"}[15m]))",
          "legendFormat": "{{channel}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "sum(avg_over_time(emporia_power_watts{channel_num=\"Balance\"}[15m]))",
          "legendFormat": "Unlabelled",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisWidth": 60
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Unlabelled"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8a8a8a"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "sortBy": "Mean",
          "sortDesc": true,
          "width": 400
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 15,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "transparent": true
    },
    {
      "type": "timeseries",
      "title": "Plugs (kasad)",
      "id": 14,
      "description": "Power per smart plug from kasad, if it runs alongside: under Circuits on the same time axis, with a shared crosshair, so a spike above can be put down to an appliance. Smoothed with a 5-minute mean centred on each minute (centred so events stay at the minutes the circuits show them), then averaged over each point's interval. Lines, not stacked: a plug fed from another metered plug is inside that one's reading too. Empty without kasad.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "expr": "sum by (alias) (avg_over_time(avg_over_time(kasa_power_watts{model!~\"KS.*\", model!=\"\"}[5m] offset -150s)[$__interval:1m]))",
          "legendFormat": "{{alias}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "axisWidth": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "width": 400,
          "calcs": [
            "mean",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1m",
      "transparent": true
    },
    {
      "type": "timeseries",
      "title": "Whole house",
      "description": "Everything the house draws (mains), per minute.",
      "targets": [
        {
          "expr": "sum(emporia_power_watts{channel_num=\"1,2,3\"})",
          "legendFormat": "Whole house",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "axisWidth": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "width": 400
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 17,
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "transparent": true
    },
    {
      "type": "bargauge",
      "title": "Latest minute by circuit",
      "description": "Each circuit's power in the newest minute pushed (up to about 17 minutes old).",
